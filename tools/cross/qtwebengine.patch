+++ b/src/host/BUILD.arbiter-apple.toolchain.gn.in
@@ -0,0 +1,17 @@
+# Native Apple tools for a Windows target. No Windows programs run here.
+import("//build/config/mac/mac_sdk.gni")
+import("//build/toolchain/apple/toolchain.gni")
+apple_toolchain("@GN_TOOLCHAIN@") {
+  bin_path = mac_bin_path
+  cc = "@GN_C_COMPILER@"
+  cxx = "@GN_CXX_COMPILER@"
+  toolchain_args = {
+    current_os = "mac"
+    current_cpu = "@GN_CPU@"
+    v8_current_cpu = "@GN_V8_CPU@"
+    is_clang = true
+    is_mingw = false
+    is_msvc = false
+    use_lld = false
+  }
+}
