[
  {
    "namespace": "scripting",
    "description": "Use the <code>chrome.scripting</code> API to execute script in different contexts.",
    "nodoc": false,
    "types": [
      {
        "id": "StyleOrigin",
        "description": "The origin for a style change. See <a href=\"https://developer.mozilla.org/en-US/docs/Glossary/Style_origin\">style origins</a> for more info.",
        "type": "string",
        "enum": [
          {
            "name": "AUTHOR"
          },
          {
            "name": "USER"
          }
        ]
      },
      {
        "id": "ExecutionWorld",
        "description": "The JavaScript world for a script to execute within.",
        "type": "string",
        "enum": [
          {
            "name": "ISOLATED",
            "description": "Specifies the isolated world, which is the execution environment unique to this extension."
          },
          {
            "name": "MAIN",
            "description": "Specifies the main world of the DOM, which is the execution environment shared with the host page's JavaScript."
          }
        ]
      },
      {
        "id": "InjectionTarget",
        "properties": {
          "tabId": {
            "description": "The ID of the tab into which to inject.",
            "name": "tabId",
            "type": "integer"
          },
          "frameIds": {
            "optional": true,
            "description": "The <a href=\"https://developer.chrome.com/extensions/webNavigation#frame_ids\">IDs</a> of specific frames to inject into.",
            "name": "frameIds",
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "documentIds": {
            "optional": true,
            "description": "The <a href=\"https://developer.chrome.com/extensions/webNavigation#document_ids\">IDs</a> of specific documentIds to inject into. This must not be set if <code>frameIds</code> is set.",
            "name": "documentIds",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "allFrames": {
            "optional": true,
            "description": "Whether the script should inject into all frames within the tab. Defaults to false. This must not be true if <code>frameIds</code> is specified.",
            "name": "allFrames",
            "type": "boolean"
          }
        },
        "type": "object"
      },
      {
        "id": "ScriptInjection",
        "properties": {
          "func": {
            "serializableFunction": true,
            "optional": true,
            "description": "A JavaScript function to inject. This function will be serialized, and then deserialized for injection. This means that any bound parameters and execution context will be lost. Exactly one of <code>files</code> or <code>func</code> must be specified.",
            "name": "func",
            "parameters": [],
            "type": "function"
          },
          "args": {
            "optional": true,
            "description": "The arguments to pass to the provided function. This is only valid if the <code>func</code> parameter is specified. These arguments must be JSON-serializable.",
            "name": "args",
            "type": "array",
            "items": {
              "type": "any"
            }
          },
          "function": {
            "nodoc": true,
            "serializableFunction": true,
            "optional": true,
            "description": "We used to call the injected function `function`, but this is incompatible with JavaScript's object declaration shorthand (see https://crbug.com/1166438). We leave this silently in for backwards compatibility. TODO(devlin): Remove this in M95.",
            "name": "function",
            "parameters": [],
            "type": "function"
          },
          "files": {
            "optional": true,
            "description": "The path of the JS or CSS files to inject, relative to the extension's root directory. Exactly one of <code>files</code> or <code>func</code> must be specified.",
            "name": "files",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "target": {
            "description": "Details specifying the target into which to inject the script.",
            "name": "target",
            "$ref": "InjectionTarget"
          },
          "world": {
            "optional": true,
            "description": "The JavaScript \"world\" to run the script in. Defaults to <code>ISOLATED</code>.",
            "name": "world",
            "$ref": "ExecutionWorld"
          },
          "injectImmediately": {
            "optional": true,
            "description": "Whether the injection should be triggered in the target as soon as possible. Note that this is not a guarantee that injection will occur prior to page load, as the page may have already loaded by the time the script reaches the target.",
            "name": "injectImmediately",
            "type": "boolean"
          }
        },
        "type": "object"
      },
      {
        "id": "CSSInjection",
        "properties": {
          "target": {
            "description": "Details specifying the target into which to insert the CSS.",
            "name": "target",
            "$ref": "InjectionTarget"
          },
          "css": {
            "optional": true,
            "description": "A string containing the CSS to inject. Exactly one of <code>files</code> and <code>css</code> must be specified.",
            "name": "css",
            "type": "string"
          },
          "files": {
            "optional": true,
            "description": "The path of the CSS files to inject, relative to the extension's root directory. Exactly one of <code>files</code> and <code>css</code> must be specified.",
            "name": "files",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "origin": {
            "optional": true,
            "description": "The style origin for the injection. Defaults to <code>'AUTHOR'</code>.",
            "name": "origin",
            "$ref": "StyleOrigin"
          }
        },
        "type": "object"
      },
      {
        "id": "InjectionResult",
        "properties": {
          "result": {
            "optional": true,
            "description": "The result of the script execution.",
            "name": "result",
            "type": "any"
          },
          "frameId": {
            "description": "The frame associated with the injection.",
            "name": "frameId",
            "type": "integer"
          },
          "documentId": {
            "description": "The document associated with the injection.",
            "name": "documentId",
            "type": "string"
          }
        },
        "type": "object"
      }
    ],
    "functions": [
      {
        "description": "Injects a script into a target context. By default, the script will be run at <code>document_idle</code>, or immediately if the page has already loaded. If the <code>injectImmediately</code> property is set, the script will inject without waiting, even if the page has not finished loading. If the script evaluates to a promise, the browser will wait for the promise to settle and return the resulting value.",
        "parameters": [
          {
            "name": "injection",
            "$ref": "ScriptInjection",
            "description": "The details of the script which to inject."
          }
        ],
        "returns_async": {
          "name": "callback",
          "optional": true,
          "parameters": [
            {
              "name": "results",
              "type": "array",
              "items": {
                "$ref": "InjectionResult"
              }
            }
          ],
          "description": "Invoked upon completion of the injection. The resulting array contains the result of execution for each frame where the injection succeeded."
        },
        "name": "executeScript",
        "type": "function",
        "nocompile": true
      },
      {
        "description": "Inserts a CSS stylesheet into a target context. If multiple frames are specified, unsuccessful injections are ignored.",
        "parameters": [
          {
            "name": "injection",
            "$ref": "CSSInjection",
            "description": "The details of the styles to insert."
          }
        ],
        "returns_async": {
          "name": "callback",
          "optional": true,
          "parameters": [],
          "description": "Invoked upon completion of the insertion."
        },
        "name": "insertCSS",
        "type": "function",
        "nocompile": true
      },
      {
        "description": "Removes a CSS stylesheet that was previously inserted by this extension from a target context.",
        "parameters": [
          {
            "name": "injection",
            "$ref": "CSSInjection",
            "description": "The details of the styles to remove. Note that the <code>css</code>, <code>files</code>, and <code>origin</code> properties must exactly match the stylesheet inserted through $(ref:insertCSS). Attempting to remove a non-existent stylesheet is a no-op."
          }
        ],
        "returns_async": {
          "name": "callback",
          "optional": true,
          "parameters": [],
          "description": "A callback to be invoked upon the completion of the removal."
        },
        "name": "removeCSS",
        "type": "function",
        "nocompile": true
      }
    ],
    "properties": {
      "globalParams": {
        "nodoc": true,
        "nocompile": true,
        "description": "An object available for content scripts running in isolated worlds to use and modify as a JS object. One instance exists per frame and is shared between all content scripts for a given extension. This object is initialized when the frame is created, before document_start. TODO(crbug.com/40119604): Enable this once implementation is complete.",
        "type": "integer"
      }
    },
    "manifest_keys": null,
    "events": [],
    "platforms": null,
    "compiler_options": {},
    "deprecated": null
  }
]
