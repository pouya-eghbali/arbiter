+void WebAuthenticationDelegateQt::IsUserVerifyingPlatformAuthenticatorAvailableOverride(
+        content::RenderFrameHost *frame, base::OnceCallback<void(std::optional<bool>)> callback)
+{
+    auto *provider = arbiterPasskeyProvider();
+    if (provider && provider->property("configured").toBool() && !frame->GetBrowserContext()->IsOffTheRecord())
+        std::move(callback).Run(true);
+    else
+        std::move(callback).Run(std::nullopt);
+}
+
+void AuthenticatorRequestClientDelegateQt::ConfigureDiscoveries(
+        const url::Origin &origin, const std::string &rp, RequestSource source,
+        device::FidoRequestType type, std::optional<device::ResidentKeyRequirement> resident,
+        device::UserVerificationRequirement uv, std::optional<std::string_view> user,
+        base::span<const device::CableDiscoveryData> pairings, bool enclave,
+        device::FidoDiscoveryFactory *factory)
+{
+    auto *provider = arbiterPasskeyProvider();
+    // Conditional/virtual requests retain stock behavior until the app implements
+    // conditional account UI. No renderer can install this browser-process hook.
+    if (!provider || source != RequestSource::kWebAuthentication
+        || m_isUiDisabled || IsVirtualEnvironmentEnabled()
+        || m_dialogController->uiPresentation() != UIPresentation::kModal) return;
+    m_arbiter = std::make_unique<ArbiterWebAuthnRequest>();
+    m_arbiter->origin = QString::fromStdString(origin.Serialize());
+    m_arbiter->rp = QString::fromStdString(rp);
+    m_arbiter->registration = type == device::FidoRequestType::kMakeCredential;
+    m_localConfigured = provider->property("configured").toBool()
+        && !m_renderFrameHost->GetBrowserContext()->IsOffTheRecord();
+    auto weak = m_weakFactory.GetWeakPtr();
+    m_arbiter->dispatchLocal = [weak] {
+        if (weak && weak->m_requestCallback && weak->m_arbiter->localAvailable)
+            weak->m_requestCallback.Run("arbiter-local-v1");
+    };
+    m_arbiter->dispatchSystem = [weak] {
+        if (weak && weak->m_requestCallback && !weak->m_systemAuthenticator.empty())
+            weak->m_requestCallback.Run(weak->m_systemAuthenticator);
+    };
+    m_arbiter->powerBluetooth = [weak] {
+        if (weak && weak->m_bluetoothAdapterPowerOnCallback) weak->m_bluetoothAdapterPowerOnCallback.Run();
+    };
+    m_arbiter->permitBluetooth = [weak] {
+        if (weak && weak->m_blePermission)
+            weak->m_blePermission.Run(base::BindOnce([](base::WeakPtr<AuthenticatorRequestClientDelegateQt> delegate,
+                    device::FidoRequestHandlerBase::BleStatus status) {
+                if (delegate) delegate->BluetoothAdapterStatusChanged(status);
+            }, weak));
+    };
+    std::array<uint8_t, device::cablev2::kQRKeySize> qrKey;
+    base::RandBytes(qrKey);
+    m_arbiter->qrPayload = QString::fromStdString(device::cablev2::qr::Encode(qrKey, type));
+    factory->set_cable_data(type, {}, qrKey);
+    factory->set_network_context_factory(base::BindRepeating([](
+            base::WeakPtr<AuthenticatorRequestClientDelegateQt> delegate) -> network::mojom::NetworkContext * {
+        return delegate ? delegate->m_renderFrameHost->GetBrowserContext()->GetDefaultStoragePartition()->GetNetworkContext() : nullptr;
+    }, weak));
+}
+
+std::vector<std::unique_ptr<device::FidoDiscoveryBase>> AuthenticatorRequestClientDelegateQt::CreatePlatformDiscoveries()
+{
+    std::vector<std::unique_ptr<device::FidoDiscoveryBase>> result;
+    if (m_arbiter && m_localConfigured) result.push_back(createArbiterDiscovery(m_arbiter.get()));
+    return result;
+}
+bool AuthenticatorRequestClientDelegateQt::EmbedderControlsAuthenticatorDispatch(const device::FidoAuthenticator &authenticator)
+{
+    if (!m_arbiter) return content::AuthenticatorRequestClientDelegate::EmbedderControlsAuthenticatorDispatch(authenticator);
+    return authenticator.GetId() == "arbiter-local-v1" || authenticator.GetType() == device::AuthenticatorType::kWinNative;
+}
+void AuthenticatorRequestClientDelegateQt::FidoAuthenticatorAdded(const device::FidoAuthenticator &authenticator)
+{
+    if (m_arbiter && authenticator.GetId() == "arbiter-local-v1") {
+        m_arbiter->localAvailable = true;
+        Q_EMIT m_arbiter->changed();
+    }
+    if (m_arbiter && authenticator.GetType() == device::AuthenticatorType::kWinNative) {
+        m_systemAuthenticator = authenticator.GetId();
+        m_arbiter->systemAvailable = true;
+        Q_EMIT m_arbiter->changed();
+    }
+}
+void AuthenticatorRequestClientDelegateQt::BluetoothAdapterStatusChanged(device::FidoRequestHandlerBase::BleStatus status)
+{
+    if (m_arbiter) { m_arbiter->bluetooth = static_cast<int>(status); Q_EMIT m_arbiter->changed(); }
+}
+
 }
