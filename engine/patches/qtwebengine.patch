+void ExtensionLoader::PostActivateExtension(scoped_refptr<const Extension> extension)
+{
+    // Installation stays disabled until Arbiter's permission review is approved.
+    // Deliver initialization once per version, only after activation, rather than
+    // running extension code when its files are merely installed.
+    if (extension->location() == extensions::mojom::ManifestLocation::kComponent
+        || extension->location() == extensions::mojom::ManifestLocation::kExternalComponent) return;
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(FROM_HERE,
+        base::BindOnce([](base::WeakPtr<ExtensionLoader> loader, std::string id) {
+            if (!loader || !loader->isExtensionEnabled(id)) return;
+            auto extension = loader->getExtensionById(id);
+            auto *prefs = extensions::ExtensionPrefs::Get(loader->m_browserContext);
+            std::string previous;
+            prefs->ReadPrefAsString(id, "arbiter_initialized_version", &previous);
+            if (previous == extension->version().GetString()) return;
+            prefs->UpdateExtensionPref(id, "arbiter_initialized_version", base::Value(extension->version().GetString()));
+            extensions::RuntimeEventRouter::DispatchOnInstalledEvent(loader->m_browserContext, id, base::Version(previous), false);
+        }, m_weakFactory.GetWeakPtr(), extension->id()));
+}
