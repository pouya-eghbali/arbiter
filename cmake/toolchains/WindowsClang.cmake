# Native Clang/LLD targeting the MSVC ABI. No MinGW or Windows executables.
set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR AMD64)
set(CMAKE_CROSSCOMPILING TRUE)
set(CMAKE_POLICY_DEFAULT_CMP0091 NEW)
set(CMAKE_MSVC_RUNTIME_LIBRARY MultiThreadedDLL CACHE STRING "MSVC release runtime")

foreach(name ARBITER_WINDOWS_SYSROOT ARBITER_WINDOWS_LLVM ARBITER_WINDOWS_LLD)
    if(NOT DEFINED ${name} AND DEFINED ENV{${name}})
        set(${name} "$ENV{${name}}" CACHE PATH "Windows cross-build input")
    endif()
    if(NOT IS_DIRECTORY "${${name}}")
        message(FATAL_ERROR "Set ${name} to an existing directory; see docs/windows-cross-build.md")
    endif()
endforeach()
foreach(tool clang-cl llvm-lib llvm-rc llvm-mt)
    if(NOT EXISTS "${ARBITER_WINDOWS_LLVM}/bin/${tool}")
        message(FATAL_ERROR "Missing native LLVM tool: ${ARBITER_WINDOWS_LLVM}/bin/${tool}")
    endif()
endforeach()
set(CMAKE_C_COMPILER "${ARBITER_WINDOWS_LLVM}/bin/clang-cl")
set(CMAKE_CXX_COMPILER "${ARBITER_WINDOWS_LLVM}/bin/clang-cl")
set(CMAKE_C_COMPILER_TARGET x86_64-pc-windows-msvc)
set(CMAKE_CXX_COMPILER_TARGET x86_64-pc-windows-msvc)
set(CMAKE_LINKER "${ARBITER_WINDOWS_LLD}/bin/lld-link")
set(CMAKE_AR "${ARBITER_WINDOWS_LLVM}/bin/llvm-lib")
set(CMAKE_RC_COMPILER "${ARBITER_WINDOWS_LLVM}/bin/llvm-rc")
set(CMAKE_MT "${ARBITER_WINDOWS_LLVM}/bin/llvm-mt")

set(_arbiter_includes "")
set(_arbiter_rc "")
foreach(suffix crt/include sdk/include/ucrt sdk/include/shared sdk/include/um sdk/include/winrt sdk/include/cppwinrt)
    if(NOT IS_DIRECTORY "${ARBITER_WINDOWS_SYSROOT}/${suffix}")
        message(FATAL_ERROR "Incomplete xwin sysroot: ${suffix}")
    endif()
    string(APPEND _arbiter_includes " /imsvc\"${ARBITER_WINDOWS_SYSROOT}/${suffix}\"")
    string(APPEND _arbiter_rc " /I\"${ARBITER_WINDOWS_SYSROOT}/${suffix}\"")
endforeach()
set(CMAKE_C_FLAGS_INIT "${_arbiter_includes} /clang:-fms-compatibility-version=19.44")
set(CMAKE_CXX_FLAGS_INIT "${_arbiter_includes} /clang:-fms-compatibility-version=19.44 /EHsc")
set(CMAKE_RC_FLAGS_INIT "${_arbiter_rc}")
set(_arbiter_link "")
foreach(suffix crt/lib/x86_64 sdk/lib/ucrt/x86_64 sdk/lib/um/x86_64)
    if(NOT IS_DIRECTORY "${ARBITER_WINDOWS_SYSROOT}/${suffix}")
        message(FATAL_ERROR "Incomplete xwin sysroot: ${suffix}")
    endif()
    string(APPEND _arbiter_link " /libpath:\"${ARBITER_WINDOWS_SYSROOT}/${suffix}\"")
endforeach()
set(CMAKE_EXE_LINKER_FLAGS_INIT "${_arbiter_link}")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "${_arbiter_link}")
set(CMAKE_MODULE_LINKER_FLAGS_INIT "${_arbiter_link}")
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES ARBITER_WINDOWS_SYSROOT ARBITER_WINDOWS_LLVM ARBITER_WINDOWS_LLD)
set(CMAKE_FIND_ROOT_PATH "${ARBITER_WINDOWS_SYSROOT}")
if(ARBITER_WINDOWS_QT)
    list(APPEND CMAKE_FIND_ROOT_PATH "${ARBITER_WINDOWS_QT}")
endif()
if(ARBITER_WINDOWS_OPENSSL)
    list(APPEND CMAKE_FIND_ROOT_PATH "${ARBITER_WINDOWS_OPENSSL}")
endif()
if(ARBITER_WEBENGINE_PREFIX)
    list(APPEND CMAKE_FIND_ROOT_PATH "${ARBITER_WEBENGINE_PREFIX}")
endif()
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
