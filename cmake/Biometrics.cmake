function(arbiter_add_biometrics target)
    target_sources(${target} PRIVATE
        ${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../src/biometricauth.cpp
        ${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../src/biometricauth.h)
    if(APPLE)
        enable_language(OBJCXX)
        set(source ${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../src/biometricauth_mac.mm)
        set_source_files_properties(${source} PROPERTIES COMPILE_OPTIONS "-fobjc-arc")
        target_sources(${target} PRIVATE ${source})
        target_link_libraries(${target} PRIVATE "-framework LocalAuthentication" "-framework AppKit")
    elseif(WIN32)
        find_package(Qt6 6.12 REQUIRED COMPONENTS Concurrent)
        target_sources(${target} PRIVATE ${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../src/biometricauth_win.cpp)
        target_compile_definitions(${target} PRIVATE NOMINMAX WIN32_LEAN_AND_MEAN)
        target_link_libraries(${target} PRIVATE Qt6::Concurrent windowsapp wtsapi32)
    else()
        find_package(Qt6 6.12 REQUIRED COMPONENTS DBus)
        target_sources(${target} PRIVATE ${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../src/biometricauth_linux.cpp)
        target_link_libraries(${target} PRIVATE Qt6::DBus)
    endif()
endfunction()
