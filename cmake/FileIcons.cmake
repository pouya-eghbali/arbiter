function(arbiter_add_file_icons target)
    target_sources(${target} PRIVATE ${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../src/fileicons.cpp ${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../src/fileicons.h)
    if(APPLE)
        enable_language(OBJCXX)
        target_sources(${target} PRIVATE ${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../src/fileicons_mac.mm)
        target_link_libraries(${target} PRIVATE "-framework AppKit" "-framework UniformTypeIdentifiers")
    elseif(WIN32)
        target_link_libraries(${target} PRIVATE Qt6::Widgets)
    endif()
endfunction()
