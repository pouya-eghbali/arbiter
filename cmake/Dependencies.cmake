include_guard(GLOBAL)
file(READ "${CMAKE_CURRENT_LIST_DIR}/../engine/manifest.json" ARBITER_ENGINE_MANIFEST)
string(JSON ARBITER_QT_VERSION GET "${ARBITER_ENGINE_MANIFEST}" qt)
string(REGEX MATCH "^[0-9]+\\.[0-9]+" ARBITER_QT_SERIES "${ARBITER_QT_VERSION}")
file(READ "${CMAKE_CURRENT_LIST_DIR}/../dependencies.json" ARBITER_DEPENDENCIES)
string(JSON ARBITER_KEYCHAIN_VERSION GET "${ARBITER_DEPENDENCIES}" qtkeychain version)
string(JSON ARBITER_KEYCHAIN_SHA256 GET "${ARBITER_DEPENDENCIES}" qtkeychain sha256)
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
    "${CMAKE_CURRENT_LIST_DIR}/../engine/manifest.json"
    "${CMAKE_CURRENT_LIST_DIR}/../dependencies.json")
