include_guard(GLOBAL)
function(arbiter_add_native_glass target)
    set(root "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/..")
    target_sources(${target} PRIVATE "${root}/src/nativeglass/nativeglasshost.cpp" "${root}/src/nativeglass/nativeglasshost.h")
    target_include_directories(${target} PRIVATE "${root}/src/nativeglass")
    if(APPLE)
        enable_language(OBJCXX)
        target_sources(${target} PRIVATE "${root}/src/nativeglass/nativeglass_apple.mm")
        set_source_files_properties("${root}/src/nativeglass/nativeglass_apple.mm" PROPERTIES COMPILE_OPTIONS "-fobjc-arc")
        if(IOS)
            target_link_libraries(${target} PRIVATE "-framework UIKit")
        else()
            target_link_libraries(${target} PRIVATE "-framework AppKit")
        endif()
    endif()
endfunction()
