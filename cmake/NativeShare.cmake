function(arbiter_add_native_share target)
    target_sources(${target} PRIVATE ${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../src/nativeshare.cpp ${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../src/nativeshare.h)
    if(APPLE)
        enable_language(OBJCXX)
        set(source ${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../src/nativeshare_mac.mm)
        set_source_files_properties(${source} PROPERTIES COMPILE_OPTIONS "-fobjc-arc")
        target_sources(${target} PRIVATE ${source})
        target_link_libraries(${target} PRIVATE "-framework AppKit")
    elseif(WIN32)
        target_sources(${target} PRIVATE ${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../src/nativeshare_win.cpp)
        target_compile_definitions(${target} PRIVATE NOMINMAX WIN32_LEAN_AND_MEAN)
        target_link_libraries(${target} PRIVATE windowsapp shlwapi shcore)
    else()
        target_sources(${target} PRIVATE ${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../src/nativeshare_linux.cpp)
        target_link_libraries(${target} PRIVATE Qt6::Widgets)
        option(ARBITER_KDE_PURPOSE "Use KDE Purpose's installed native sharing providers" OFF)
        if(ARBITER_KDE_PURPOSE)
            find_package(KF6Purpose REQUIRED)
            target_compile_definitions(${target} PRIVATE ARBITER_KDE_PURPOSE=1)
            target_link_libraries(${target} PRIVATE KF6::Purpose KF6::PurposeWidgets)
        endif()
    endif()
endfunction()
