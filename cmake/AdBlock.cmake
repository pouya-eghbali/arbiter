include_guard(GLOBAL)
find_program(ARBITER_CARGO cargo HINTS "$ENV{HOME}/.cargo/bin")
if(NOT ARBITER_CARGO)
    find_program(ARBITER_RUSTUP rustup)
    if(ARBITER_RUSTUP)
        execute_process(COMMAND "${ARBITER_RUSTUP}" which cargo OUTPUT_VARIABLE ARBITER_CARGO OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
    endif()
endif()
if(NOT EXISTS "${ARBITER_CARGO}")
    message(FATAL_ERROR "Rust/Cargo is required for the built-in ad blocker. Install a Rust 1.93+ toolchain.")
endif()
get_filename_component(ARBITER_RUST_BIN "${ARBITER_CARGO}" DIRECTORY)
set(ARBITER_RUST_TARGET "" CACHE STRING "Rust target triple for cross compilation; empty uses the host")
get_filename_component(ARBITER_ADBLOCK_ROOT "${CMAKE_CURRENT_LIST_DIR}/../rust/adblock" ABSOLUTE)
set(ARBITER_CARGO_HOME "${ARBITER_ADBLOCK_ROOT}/../../build-rust-cargo" CACHE PATH "Cargo dependency cache")
if(CMAKE_HOST_WIN32)
    set(ARBITER_RUST_EXE_SUFFIX ".exe")
else()
    set(ARBITER_RUST_EXE_SUFFIX "")
endif()
set(ARBITER_RUST_OUTPUT "${CMAKE_BINARY_DIR}/adblock-rust")
set(ARBITER_RUST_FLAGS)
set(ARBITER_RUST_SUBDIR)
if(ARBITER_RUST_TARGET)
    list(APPEND ARBITER_RUST_FLAGS --target "${ARBITER_RUST_TARGET}")
    set(ARBITER_RUST_SUBDIR "${ARBITER_RUST_TARGET}/")
elseif(CMAKE_CROSSCOMPILING)
    message(FATAL_ERROR "Set ARBITER_RUST_TARGET to match the Qt target when cross compiling")
endif()
if(APPLE AND CMAKE_OSX_ARCHITECTURES MATCHES ";")
    message(FATAL_ERROR "Build each macOS architecture separately with its matching ARBITER_RUST_TARGET before combining bundles")
endif()
if(WIN32 AND NOT MINGW)
    set(ARBITER_RUST_LIBRARY "${ARBITER_RUST_OUTPUT}/${ARBITER_RUST_SUBDIR}release/arbiter_adblock.lib")
else()
    set(ARBITER_RUST_LIBRARY "${ARBITER_RUST_OUTPUT}/${ARBITER_RUST_SUBDIR}release/libarbiter_adblock.a")
endif()
add_custom_command(OUTPUT "${ARBITER_RUST_LIBRARY}"
    COMMAND "${CMAKE_COMMAND}" -E env "RUSTC=${ARBITER_RUST_BIN}/rustc${ARBITER_RUST_EXE_SUFFIX}" "CARGO_HOME=${ARBITER_CARGO_HOME}"
        "${ARBITER_CARGO}" build --manifest-path "${ARBITER_ADBLOCK_ROOT}/Cargo.toml" --locked --release --jobs 24 --target-dir "${ARBITER_RUST_OUTPUT}" ${ARBITER_RUST_FLAGS}
    DEPENDS "${ARBITER_ADBLOCK_ROOT}/Cargo.toml" "${ARBITER_ADBLOCK_ROOT}/Cargo.lock" "${ARBITER_ADBLOCK_ROOT}/src/lib.rs"
    VERBATIM)
add_custom_target(arbiter_adblock_rust DEPENDS "${ARBITER_RUST_LIBRARY}")
add_library(arbiter_adblock_engine STATIC IMPORTED GLOBAL)
set_target_properties(arbiter_adblock_engine PROPERTIES IMPORTED_LOCATION "${ARBITER_RUST_LIBRARY}")
add_dependencies(arbiter_adblock_engine arbiter_adblock_rust)
if(WIN32)
    target_link_libraries(arbiter_adblock_engine INTERFACE ws2_32 bcrypt userenv ntdll)
elseif(APPLE)
    target_link_libraries(arbiter_adblock_engine INTERFACE "-framework Security" "-framework SystemConfiguration")
else()
    target_link_libraries(arbiter_adblock_engine INTERFACE ${CMAKE_DL_LIBS} pthread m)
endif()
