{
  "manifest_version": 2,
  "name": "Arbiter credential bridge",
  "version": "1.0",
  "browser_specific_settings": {"gecko": {"id": "credentials@arbiter.internal"}},
  "permissions": ["nativeMessaging", "nativeMessagingFromContent", "geckoViewAddons"],
  "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["forms.js"], "run_at": "document_end", "all_frames": false}]
}
